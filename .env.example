# Salin file ini jadi ".env" (hapus ".example") lalu isi sesuai server WhatsApp gateway kamu.
# File ".env" TIDAK di-commit ke git (sudah ada di .gitignore) - aman isi data asli di situ.

# ============================================================
# Data kontak pribadi
# ============================================================
CANDIDATE_PHONE=081234567890
CANDIDATE_EMAIL=nama.kamu@email.com

# ============================================================
# Server WhatsApp gateway
# ============================================================
WA_BASE_URL=http://localhost:3000
WA_AUTH_USER=user1
WA_AUTH_PASS=pass1

# Isi kalau kamu login lebih dari 1 nomor/device di server WA-nya. Kosongkan kalau cuma 1.
WA_DEVICE_ID=

# Set ke "false" buat matiin notifikasi WhatsApp sama sekali (scraper tetap jalan normal)
WA_ENABLED=true

# Set ke "true" pas lagi testing/ubah-ubah setting - pesan tetap dibikin & dicatat
# di log, tapi TIDAK BENERAN DIKIRIM ke siapapun. Balikin ke "false" kalau udah
# yakin mau kirim beneran.
WA_DRY_RUN=false

# ============================================================
# Tujuan notifikasi (WA_TARGET) - INI YANG PALING SERING DIEDIT
# ============================================================
#
# --- Kirim ke NOMOR PRIBADI ---
# Format:  62<nomor tanpa angka 0 di depan>@s.whatsapp.net
# Contoh:  nomor 0858-1227-2218  ->  6281234567890@s.whatsapp.net
#
# --- Kirim ke GRUP WhatsApp ---
# Format:  <ID grup>@g.us
# Contoh:  123456789012345678@g.us
# Cara dapetin ID grup: biasanya server WA gateway kamu punya endpoint buat
# list grup yang diikuti (cek dokumentasi API-nya, misal GET /group/list atau
# semacamnya) - ID-nya muncul di situ, tinggal disalin.
#
# --- Kirim ke BEBERAPA tujuan sekaligus (nomor + grup, atau banyak nomor) ---
# Pisahkan pakai koma, TANPA spasi setelah koma juga boleh (otomatis dirapikan):
# WA_TARGET=6281234567890@s.whatsapp.net,123456789012345678@g.us
#
# --- Cuma 1 tujuan (paling umum) ---
WA_TARGET=6281234567890@s.whatsapp.net

# ============================================================
# LinkedIn feed-post search (opsional)
# ============================================================
# Kosongin kalau gak dipakai. Diisi lewat dashboard sendiri (tombol
# "LinkedIn feed login" di tab Scraped postings) - ini cuma dokumentasi
# format, gak perlu diisi manual di sini. Nilainya cookie "li_at" dari
# sesi LinkedIn kamu sendiri yang UDAH login (lihat DevTools > Application
# > Cookies > linkedin.com). Setara dengan login sebagai kamu - melanggar
# Ketentuan Layanan LinkedIn dan beresiko kena pembatasan akun kalau dipakai
# otomatis, jangan share nilainya ke siapapun.
LINKEDIN_LI_AT_COOKIE=
